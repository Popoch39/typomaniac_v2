# Copy to `.env` in this folder: Bun loads it for `bun run dev` and `bun test`.
# Matches the Postgres started by the root `compose.yaml`.
DATABASE_URL=postgres://typomaniac:typomaniac@localhost:5432/typomaniac
# Matches the Redis started by the root `compose.yaml`.
REDIS_URL=redis://localhost:6380

# Signs session cookies: generate your own with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public origin the API is reached at, without the /api/auth path. In dev it is the Vite server,
# which proxies /api: Better Auth refuses a sign-in whose Origin is not this one.
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth App (https://github.com/settings/developers).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
# Discord application (https://discord.com/developers/applications), OAuth2 tab.
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=replace-with-your-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-your-discord-client-secret

# Development only: lets the app sign in as dev_alice or dev_bob with one click, to play a Duel
# against yourself. The API refuses to start with it under NODE_ENV=production.
DEV_SIGN_IN=enabled

# Only behind a reverse proxy that sets X-Forwarded-For: the rate limits then count each request
# against the leftmost address of that header instead of the socket's. Left unset when the API is
# reached directly, or any client could pick the address it is counted against.
# TRUST_PROXY=enabled

# Optional: trace, debug, info (default), warn, error or fatal.
# LOG_LEVEL=info
