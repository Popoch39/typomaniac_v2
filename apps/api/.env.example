# Copy to `.env` in this folder: Bun loads it for `bun run dev` and `bun test`.
# Matches the Postgres started by the root `compose.yaml`.
DATABASE_URL=postgres://typomaniac:typomaniac@localhost:5432/typomaniac

# Signs session cookies: generate your own with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public origin the API is reached at, without the /api/auth path.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (https://github.com/settings/developers).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
# Discord application (https://discord.com/developers/applications), OAuth2 tab.
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=replace-with-your-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-your-discord-client-secret
