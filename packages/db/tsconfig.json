{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    // No DOM lib: this package only runs on Bun, whose built-in SQL client it opens.
    "lib": ["es2022"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../typing-engine" },
    { "path": "../duel-engine" },
    { "path": "../fair-play-engine" },
    { "path": "../ranked-engine" }
  ]
}
