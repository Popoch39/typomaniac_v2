{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    // No DOM lib and no ambient types: the typecheck is what guarantees the engine stays pure.
    "lib": ["es2022"],
    "types": [],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../typing-engine" }, { "path": "../duel-engine" }]
}
