{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    // No DOM lib: this package only runs on Bun, against the Redis the API and the matchmaker share.
    "lib": ["es2022"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../redis" }, { "path": "../matchmaking-engine" }]
}
