# Copy to `.env` at the repository root: docker compose reads it.
# The API reads its own `apps/api/.env` (see `apps/api/.env.example`).
POSTGRES_USER=typomaniac
POSTGRES_PASSWORD=typomaniac
POSTGRES_DB=typomaniac
POSTGRES_PORT=5432
# compose.prod.yaml only.
API_PORT=3000
# Generate the secret with `openssl rand -base64 32`; the URL is the public origin of the API.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
